// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for admin authentication (better-auth compatible)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(true)
  name          String
  image         String?
  role          UserRole @default(ADMIN)
  disabledAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  articles                 Article[]
  auditLogs                AuditLog[]
  accounts                 Account[]
  sessions                 Session[]
  invitations              UserInvitation[]
  revisions                ContentRevision[]
  tasksRequested  Task[]           @relation("TaskRequester")
  tasksAssigned   Task[]           @relation("TaskAssignee")
  taskActivities  TaskActivity[]
  taskReceipts    TaskReadReceipt[]
  taskAttachments TaskAttachment[]
  memberPilotAccess         MemberPilotAccess?      @relation("MemberPilotUser")
  memberPilotAccessGranted  MemberPilotAccess[]     @relation("MemberPilotGrantor")
  memberCapabilityGrants    MemberCapabilityGrant[] @relation("MemberCapabilityUser")
  memberCapabilitiesGranted MemberCapabilityGrant[] @relation("MemberCapabilityGrantor")
  memberWardScopes          MemberWardScope[]       @relation("MemberWardScopeUser")
  memberWardScopesGranted   MemberWardScope[]       @relation("MemberWardScopeGrantor")
  memberAuditEvents         MemberAuditEvent[]      @relation("MemberAuditActor")

  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
}

enum MemberCapability {
  MEMBER_ACCESS_ADMIN
  MEMBER_READ
  MEMBER_WRITE
  HOUSEHOLD_WRITE
  WARD_WRITE
  MEMBER_EXPORT
  MEMBER_IMPORT_PREVIEW
  MEMBER_AUDIT_READ
}

enum MemberAccessScope {
  GLOBAL
  WARDS
}

model MemberPilotAccess {
  id          String    @id @default(cuid())
  userId      String    @unique
  grantedById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User @relation("MemberPilotUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("MemberPilotGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@map("member_pilot_access")
}

model MemberCapabilityGrant {
  id          String           @id @default(cuid())
  userId      String
  capability  MemberCapability
  scope       MemberAccessScope @default(WARDS)
  grantedById String
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User @relation("MemberCapabilityUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("MemberCapabilityGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, capability])
  @@index([capability, expiresAt])
  @@map("member_capability_grants")
}

model MemberWardScope {
  id          String    @id @default(cuid())
  userId      String
  wardId      String
  grantedById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User @relation("MemberWardScopeUser", fields: [userId], references: [id], onDelete: Cascade)
  ward      Ward @relation(fields: [wardId], references: [id], onDelete: Cascade)
  grantedBy User @relation("MemberWardScopeGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([userId, wardId])
  @@index([wardId, expiresAt])
  @@map("member_ward_scopes")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  DEPARTED
  DECEASED
  ARCHIVED
}

enum MemberContactType {
  MOBILE
  PHONE
  EMAIL
  WHATSAPP
  OTHER
}

enum HouseholdRole {
  HEAD
  SPOUSE
  CHILD
  DEPENDANT
  OTHER
}

enum MembershipEventType {
  ARRIVAL
  BAPTISM
  PROFESSION
  CERTIFICATE_REQUESTED
  CERTIFICATE_RECEIVED
  DEPARTURE
  RETURNED
  DEATH
  STATUS_CHANGED
  OTHER
}

model Member {
  id            String       @id @default(cuid())
  firstNames    String
  preferredName String?
  lastName      String
  birthDate     DateTime?    @db.Date
  status        MemberStatus @default(ACTIVE)
  version       Int          @default(1)
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  contacts          MemberContactPoint[]
  householdHistory HouseholdMember[]
  wardAssignments  WardAssignment[]
  elderAssignments WardElderAssignment[]
  events            MembershipEvent[]
  sourceRecords     MemberSourceRecord[]
  taskSubjects      TaskSubject[]

  @@index([lastName, firstNames])
  @@index([status, archivedAt])
  @@map("members")
}

model Household {
  id         String    @id @default(cuid())
  name       String
  version    Int       @default(1)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memberHistory   HouseholdMember[]
  addresses       HouseholdAddress[]
  wardAssignments WardAssignment[]
  taskSubjects    TaskSubject[]

  @@index([name])
  @@index([archivedAt])
  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  memberId    String
  role        HouseholdRole @default(OTHER)
  isHead      Boolean       @default(false)
  startDate   DateTime      @db.Date
  endDate     DateTime?     @db.Date
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([householdId, endDate])
  @@index([memberId, endDate])
  @@map("household_members")
}

model HouseholdAddress {
  id          String    @id @default(cuid())
  householdId String
  line1       String
  line2       String?
  suburb      String?
  city        String?
  postalCode  String?
  countryCode String    @default("ZA")
  normalized  String?
  source      String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Restrict)

  @@index([householdId, endDate])
  @@index([normalized])
  @@map("household_addresses")
}

model MemberContactPoint {
  id              String            @id @default(cuid())
  memberId        String
  type            MemberContactType
  value           String
  normalizedValue String
  isPreferred     Boolean           @default(false)
  verifiedAt      DateTime?
  startDate       DateTime          @db.Date
  endDate         DateTime?         @db.Date
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId, endDate])
  @@index([type, normalizedValue])
  @@map("member_contact_points")
}

model Ward {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  activeFrom DateTime  @db.Date
  activeTo   DateTime? @db.Date
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignments WardAssignment[]
  elderAssignments WardElderAssignment[]
  scopes      MemberWardScope[]
  taskSubjects TaskSubject[]

  @@index([activeTo])
  @@map("wards")
}

model WardElderAssignment {
  id        String    @id @default(cuid())
  wardId    String
  memberId  String
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ward   Ward   @relation(fields: [wardId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([wardId, endDate])
  @@index([memberId, endDate])
  @@map("ward_elder_assignments")
}

model WardAssignment {
  id          String    @id @default(cuid())
  memberId    String?
  householdId String?
  wardId      String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  member    Member?    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Restrict)
  ward      Ward       @relation(fields: [wardId], references: [id], onDelete: Restrict)

  @@index([memberId, endDate])
  @@index([householdId, endDate])
  @@index([wardId, endDate])
  @@map("ward_assignments")
}

model MembershipEvent {
  id            String              @id @default(cuid())
  memberId      String
  type          MembershipEventType
  effectiveDate DateTime            @db.Date
  details       Json?
  source        String?
  createdAt     DateTime            @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([memberId, effectiveDate])
  @@map("membership_events")
}

model MemberSourceRecord {
  id             String   @id @default(cuid())
  memberId       String
  sourceSystem   String
  sourceRecordId String
  batchId        String
  sourceHash     String
  comparison     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([sourceSystem, sourceRecordId])
  @@index([batchId])
  @@index([memberId])
  @@map("member_source_records")
}

model MemberAuditEvent {
  id                String   @id @default(cuid())
  entityType        String
  entityId          String
  action            String
  actorId           String?
  actorNameSnapshot String
  actorRoleSnapshot String
  source            String
  changes           Json
  createdAt         DateTime @default(now())

  actor User? @relation("MemberAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("member_audit_events")
}

// Authentication models required by better-auth
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification_tokens")
}

model UserInvitation {
  id         String               @id @default(cuid())
  email      String
  name       String
  role       UserRole             @default(ADMIN)
  token      String               @unique @default(cuid())
  status     UserInvitationStatus @default(PENDING)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Relations
  inviter User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("user_invitations")
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Service Groups (Diensgroepe)
model ServiceGroup {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  description   String
  category      ServiceGroupCategory @default(OTHER)
  contactPerson String
  contactEmail  String
  contactPhone  String?
  thumbnailUrl  String?
  bannerUrl     String?
  displayOrder  Int                  @default(0)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  contactSubmissions ContactSubmission[]

  @@map("service_groups")
}

enum ServiceGroupCategory {
  DIAKONIE
  OTHER
}

// Events and Calendar
model Event {
  id               String            @id @default(cuid())
  title            String
  description      String
  startDate        DateTime
  endDate          DateTime?
  location         String?
  categoryId       String
  isRecurring      Boolean           @default(false)
  recurringPattern RecurringPattern?
  recurrenceGroupId String?
  sermonUrl         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([recurrenceGroupId])
  @@map("events")
}

model EventCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events Event[]

  @@map("event_categories")
}

enum RecurringPattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
  FIRST_WEEKDAY_MONTHLY
  YEARLY
}

// News Articles
model Article {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  content          String // Markdown content
  excerpt          String?
  featuredImageUrl String?
  categoryId       String
  status           ArticleStatus @default(DRAFT)
  contentDate      DateTime      @default(now()) @db.Date
  showDate         Boolean       @default(true)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  authorId         String

  // Relations
  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("articles")
}

model ArticleCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  articles Article[]

  @@map("article_categories")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Reading Materials
model ReadingMaterial {
  id            String                   @id @default(cuid())
  title         String
  description   String?
  fileUrl       String?
  externalUrl   String?
  categoryId    String
  fileType      ReadingMaterialFileType?
  fileSize      Int?
  contentDate   DateTime                 @default(now()) @db.Date
  showDate      Boolean                  @default(true)
  status        ContentStatus            @default(PUBLISHED)
  isArchived    Boolean                  @default(false)
  sourceMediaId Int?                     @unique
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Relations
  category ReadingMaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("reading_materials")
}

// Structured public pages. These replace WordPress/Divi pages with guarded fields.
model ContentPage {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  sections    Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("content_pages")
}

model UploadedAsset {
  id        String   @id @default(cuid())
  url       String
  pathname  String?
  filename  String
  mimeType  String
  size      Int
  purpose   String?
  createdAt DateTime @default(now())

  @@map("uploaded_assets")
}

model ChangelogEntry {
  id          String   @id @default(cuid())
  commitSha   String
  title       String
  description String
  category    String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([commitSha, title])
  @@index([publishedAt])
  @@map("changelog_entries")
}

model ContentRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  snapshot   Json
  createdBy  String
  createdAt  DateTime @default(now())

  user User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("content_revisions")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ReadingMaterialCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  readingMaterials ReadingMaterial[]

  @@map("reading_material_categories")
}

enum ReadingMaterialFileType {
  PDF
  DOC
  AUDIO
  LINK
}

// Contact Forms
model ContactSubmission {
  id             String                  @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String
  message        String
  type           ContactSubmissionType
  serviceGroupId String?
  status         ContactSubmissionStatus @default(NEW)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Relations
  serviceGroup ServiceGroup? @relation(fields: [serviceGroupId], references: [id], onDelete: SetNull)

  @@map("contact_submissions")
}

enum ContactSubmissionType {
  GENERAL
  SERVICE_GROUP
  SPECIFIC
}

enum ContactSubmissionStatus {
  NEW
  READ
  REPLIED
}

// Internal staff tasks. Proposals are one possible task source.
model Task {
  id                  String       @id @default(cuid())
  requesterId         String
  assigneeId          String?
  title               String
  description         String
  pagePath            String?
  source              String                 @default("PROPOSAL")
  status              TaskStatus   @default(NEW)
  priority            TaskPriority @default(NORMAL)
  workflowVersion     Int                    @default(1)
  activitySeq         Int                    @default(1)
  lastActivityAt      DateTime               @default(now())
  closedAt            DateTime?
  creationKey         String
  creationPayloadHash String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  requester  User             @relation("TaskRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee   User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities TaskActivity[]
  receipts   TaskReadReceipt[]
  attachments TaskAttachment[]
  subjects    TaskSubject[]

  @@unique([requesterId, creationKey])
  @@index([requesterId, lastActivityAt, id])
  @@index([source, lastActivityAt, id])
  @@index([status, lastActivityAt, id])
  @@index([lastActivityAt, id])
  @@map("tasks")
}

model TaskActivity {
  id           String           @id @default(cuid())
  requestId    String
  actorId      String
  seq          Int
  kind         TaskActivityKind
  body         String?
  changes      Json?
  operationKey String
  payloadHash  String
  createdAt    DateTime                   @default(now())

  request Task             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  attachments TaskAttachment[]

  @@unique([requestId, seq])
  @@unique([requestId, actorId, kind, operationKey])
  @@index([requestId, seq])
  @@map("task_activities")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  requestId  String
  activityId String?
  uploaderId String
  url        String
  pathname   String
  filename   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  request  Task          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  activity TaskActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploader User          @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@unique([requestId, pathname])
  @@index([activityId])
  @@index([uploaderId])
  @@map("task_attachments")
}

model TaskReadReceipt {
  requestId   String
  userId      String
  lastReadSeq Int      @default(0)
  updatedAt   DateTime @updatedAt

  request Task @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([requestId, userId])
  @@index([userId, requestId])
  @@map("task_read_receipts")
}

model TaskSubject {
  id          String   @id @default(cuid())
  taskId      String
  memberId    String?
  householdId String?
  wardId      String?
  createdAt   DateTime @default(now())

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member    Member?    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  household Household? @relation(fields: [householdId], references: [id], onDelete: Restrict)
  ward      Ward?      @relation(fields: [wardId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([memberId])
  @@index([householdId])
  @@index([wardId])
  @@map("task_subjects")
}

enum TaskStatus {
  NEW
  PLANNED
  IN_PROGRESS
  WAITING_FOR_FEEDBACK
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT

}

enum TaskActivityKind {
  CREATED
  MESSAGE
  WORKFLOW

}

// Audit Log
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
