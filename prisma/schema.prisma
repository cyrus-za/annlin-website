// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model for admin authentication (better-auth compatible)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(true)
  name          String
  image         String?
  role          UserRole @default(ADMIN)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  articles                 Article[]
  auditLogs                AuditLog[]
  accounts                 Account[]
  sessions                 Session[]
  invitations              UserInvitation[]
  revisions                ContentRevision[]
  featureRequestsRequested FeatureRequest[]            @relation("FeatureRequestRequester")
  featureRequestsAssigned  FeatureRequest[]            @relation("FeatureRequestAssignee")
  featureRequestActivities FeatureRequestActivity[]
  featureRequestReceipts   FeatureRequestReadReceipt[]
  featureRequestAttachments FeatureRequestAttachment[]

  @@map("users")
}

enum UserRole {
  ADMIN
  EDITOR
}

// Authentication models required by better-auth
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification_tokens")
}

model UserInvitation {
  id         String               @id @default(cuid())
  email      String
  name       String
  role       UserRole             @default(ADMIN)
  token      String               @unique @default(cuid())
  status     UserInvitationStatus @default(PENDING)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Relations
  inviter User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("user_invitations")
}

enum UserInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Service Groups (Diensgroepe)
model ServiceGroup {
  id            String               @id @default(cuid())
  name          String
  slug          String               @unique
  description   String
  category      ServiceGroupCategory @default(OTHER)
  contactPerson String
  contactEmail  String
  contactPhone  String?
  thumbnailUrl  String?
  bannerUrl     String?
  displayOrder  Int                  @default(0)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  // Relations
  contactSubmissions ContactSubmission[]

  @@map("service_groups")
}

enum ServiceGroupCategory {
  DIAKONIE
  OTHER
}

// Events and Calendar
model Event {
  id               String            @id @default(cuid())
  title            String
  description      String
  startDate        DateTime
  endDate          DateTime?
  location         String?
  categoryId       String
  isRecurring      Boolean           @default(false)
  recurringPattern RecurringPattern?
  sermonUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("events")
}

model EventCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events Event[]

  @@map("event_categories")
}

enum RecurringPattern {
  WEEKLY
  MONTHLY
  YEARLY
}

// News Articles
model Article {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  content          String // Markdown content
  excerpt          String?
  featuredImageUrl String?
  categoryId       String
  status           ArticleStatus @default(DRAFT)
  contentDate      DateTime      @default(now()) @db.Date
  showDate         Boolean       @default(true)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  authorId         String

  // Relations
  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("articles")
}

model ArticleCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  articles Article[]

  @@map("article_categories")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Reading Materials
model ReadingMaterial {
  id            String                   @id @default(cuid())
  title         String
  description   String?
  fileUrl       String?
  externalUrl   String?
  categoryId    String
  fileType      ReadingMaterialFileType?
  fileSize      Int?
  contentDate   DateTime                 @default(now()) @db.Date
  showDate      Boolean                  @default(true)
  status        ContentStatus            @default(PUBLISHED)
  isArchived    Boolean                  @default(false)
  sourceMediaId Int?                     @unique
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Relations
  category ReadingMaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("reading_materials")
}

// Structured public pages. These replace WordPress/Divi pages with guarded fields.
model ContentPage {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  sections    Json
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("content_pages")
}

model UploadedAsset {
  id        String   @id @default(cuid())
  url       String
  pathname  String?
  filename  String
  mimeType  String
  size      Int
  purpose   String?
  createdAt DateTime @default(now())

  @@map("uploaded_assets")
}

model ChangelogEntry {
  id          String   @id @default(cuid())
  commitSha   String   @unique
  title       String
  description String
  category    String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([publishedAt])
  @@map("changelog_entries")
}

model ContentRevision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  snapshot   Json
  createdBy  String
  createdAt  DateTime @default(now())

  user User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@map("content_revisions")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ReadingMaterialCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  readingMaterials ReadingMaterial[]

  @@map("reading_material_categories")
}

enum ReadingMaterialFileType {
  PDF
  DOC
  AUDIO
  LINK
}

// Contact Forms
model ContactSubmission {
  id             String                  @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String
  message        String
  type           ContactSubmissionType
  serviceGroupId String?
  status         ContactSubmissionStatus @default(NEW)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Relations
  serviceGroup ServiceGroup? @relation(fields: [serviceGroupId], references: [id], onDelete: SetNull)

  @@map("contact_submissions")
}

enum ContactSubmissionType {
  GENERAL
  SERVICE_GROUP
  SPECIFIC
}

enum ContactSubmissionStatus {
  NEW
  READ
  REPLIED
}

// Internal staff proposals and their ordered conversation history.
model FeatureRequest {
  id                  String                 @id @default(cuid())
  requesterId         String
  assigneeId          String?
  title               String
  description         String
  pagePath            String?
  source              String                 @default("PROPOSAL")
  status              FeatureRequestStatus   @default(NEW)
  priority            FeatureRequestPriority @default(NORMAL)
  nextAction          String?
  workflowVersion     Int                    @default(1)
  activitySeq         Int                    @default(1)
  lastActivityAt      DateTime               @default(now())
  closedAt            DateTime?
  creationKey         String
  creationPayloadHash String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  requester  User                        @relation("FeatureRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee   User?                       @relation("FeatureRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities FeatureRequestActivity[]
  receipts   FeatureRequestReadReceipt[]
  attachments FeatureRequestAttachment[]

  @@unique([requesterId, creationKey])
  @@index([requesterId, lastActivityAt, id])
  @@index([source, lastActivityAt, id])
  @@index([status, lastActivityAt, id])
  @@index([lastActivityAt, id])
  @@map("feature_requests")
}

model FeatureRequestActivity {
  id           String                     @id @default(cuid())
  requestId    String
  actorId      String
  seq          Int
  kind         FeatureRequestActivityKind
  body         String?
  changes      Json?
  operationKey String
  payloadHash  String
  createdAt    DateTime                   @default(now())

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  attachments FeatureRequestAttachment[]

  @@unique([requestId, seq])
  @@unique([requestId, actorId, kind, operationKey])
  @@index([requestId, seq])
  @@map("feature_request_activities")
}

model FeatureRequestAttachment {
  id         String   @id @default(cuid())
  requestId  String
  activityId String?
  uploaderId String
  url        String
  pathname   String
  filename   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  request  FeatureRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  activity FeatureRequestActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  uploader User                    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@unique([requestId, pathname])
  @@index([activityId])
  @@index([uploaderId])
  @@map("feature_request_attachments")
}

model FeatureRequestReadReceipt {
  requestId   String
  userId      String
  lastReadSeq Int      @default(0)
  updatedAt   DateTime @updatedAt

  request FeatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([requestId, userId])
  @@index([userId, requestId])
  @@map("feature_request_read_receipts")
}

enum FeatureRequestStatus {
  NEW
  PLANNED
  IN_PROGRESS
  WAITING_FOR_FEEDBACK
  DONE
  NOT_PLANNED
}

enum FeatureRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeatureRequestActivityKind {
  CREATED
  MESSAGE
  WORKFLOW
}

// Audit Log
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json
  createdAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
